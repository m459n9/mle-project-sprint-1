# Скопируйте этот файл в .env (в той же папке part1_airflow) и заполните значениями.
# Файл .env добавлен в .gitignore и в репозиторий не попадает.
# Доступы к бакету S3 здесь не нужны, они перечислены в part2_dvc/.env_template.

# Общая БД курса (источник, только чтение): таблицы buildings и flats.
DB_SOURCE_HOST=<your-source-db-host>
DB_SOURCE_PORT=<your-source-db-port>
DB_SOURCE_NAME=<your-source-db-name>
DB_SOURCE_USER=<your-source-db-username>
DB_SOURCE_PASSWORD=<your-source-db-password>

# Личная БД (приёмник): в неё DAG пишут flats_dataset и clean_flats_dataset.
DB_DESTINATION_HOST=<your-destination-db-host>
DB_DESTINATION_PORT=<your-destination-db-port>
DB_DESTINATION_NAME=<your-destination-db-name>
DB_DESTINATION_USER=<your-destination-db-username>
DB_DESTINATION_PASSWORD=<your-destination-db-password>

# Telegram-бот для уведомлений об исполнении DAG.
# Токен выдаёт @BotFather, chat_id можно узнать у @userinfobot.
TELEGRAM_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# UID пользователя, от которого запускаются контейнеры Airflow (для прав на папки dags/logs/plugins)
AIRFLOW_UID=50000
